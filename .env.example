# ---------- Backend ----------
NODE_ENV=development
PORT=4000

# Supabase Postgres — use the "Session pooler" connection string from
# Project Settings > Database > Connect (the "Direct connection" host is
# IPv6-only and unreachable on many networks). URL-encode special
# characters in your password (e.g. & becomes %26).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# JWT (access token only — refresh tokens are opaque random values hashed
# and stored in the database, see RefreshToken model, not JWTs themselves)
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Resend (email OTP) — https://resend.com. FROM must be a verified domain
# sender once you leave Resend's onboarding sandbox.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Object storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BUCKET=lando-property-images
STORAGE_PRIVATE_BUCKET=lando-deed-documents

# Maps
GOOGLE_MAPS_SERVER_API_KEY=

# OCR
GOOGLE_CLOUD_VISION_API_KEY=

# Marketplace region config
MARKETPLACE_REGION=KANDY

# ---------- Mobile (Expo public env) ----------
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_GOOGLE_MAPS_CLIENT_API_KEY=
